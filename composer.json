{
    "name": "pnscripts/pnscripts-price-history",
    "description": "WooCommerce plugin: records price history and shows the lowest price in the 30 days before a discount (EU Omnibus Directive, Price Indication Directive Art. 6a).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://pnscripts.com/marketplace/pnscripts-price-history",
    "authors": [
        {
            "name": "PN Scripts",
            "homepage": "https://pnscripts.com"
        }
    ],
    "support": {
        "issues": "https://github.com/pnscripts/pnscripts-price-history/issues",
        "source": "https://github.com/pnscripts/pnscripts-price-history",
        "security": "https://github.com/pnscripts/pnscripts-price-history/security/policy"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "*",
        "php-stubs/wp-cli-stubs": "*"
    },
    "autoload": {
        "psr-4": {
            "Pnscripts\\Omnibus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pnscripts\\Omnibus\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit --colors=always",
        "test:integration": "phpunit -c phpunit-integration.xml.dist --colors=always",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=2G",
        "check": [
            "@composer audit",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "The checks CI runs, in the same order (integration tests: composer test:integration)."
    }
}
